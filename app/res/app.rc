1 ICON "cs2voice.ico"

1 VERSIONINFO
FILEVERSION CS2VOICE_MAJOR, CS2VOICE_MINOR, CS2VOICE_PATCH, 0
PRODUCTVERSION CS2VOICE_MAJOR, CS2VOICE_MINOR, CS2VOICE_PATCH, 0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "krisoft20"
            VALUE "Comments", "Free software by krisoft20, github.com/krisoft20/cs2voice"
            VALUE "FileDescription", "cs2voice"
            VALUE "FileVersion", CS2VOICE_VERSION
            VALUE "LegalCopyright", "Copyright (c) 2026 krisoft20, GPL-3.0"
            VALUE "OriginalFilename", "cs2voice.exe"
            VALUE "ProductName", "cs2voice"
            VALUE "ProductVersion", CS2VOICE_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
