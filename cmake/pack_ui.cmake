file(GLOB_RECURSE files RELATIVE "${SRC}" "${SRC}/*")
list(FILTER files EXCLUDE REGEX "\\.bin$")
list(SORT files)
set(rc "")
set(index "")
set(id 1000)
foreach(f ${files})
    string(APPEND rc "${id} RCDATA \"${SRC}/${f}\"\n")
    string(APPEND index "${id} /${f}\n")
    math(EXPR id "${id} + 1")
endforeach()
file(WRITE "${DST}/ui_index.txt" "${index}")
string(APPEND rc "999 RCDATA \"${DST}/ui_index.txt\"\n")
file(WRITE "${DST}/ui.rc" "${rc}")
